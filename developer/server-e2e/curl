#!/usr/bin/python3
"""Only the external billing-account and ACME HTTP endpoints are fixture-backed."""
import os,sys
from urllib.parse import urlsplit
args=sys.argv[1:]
for i,arg in enumerate(args):
    if arg == 'https://api.deepseek.com/v1/models':
        args[i]='http://127.0.0.1:14000/deepseek/models'
    elif arg.startswith('https://acme-v02.api.letsencrypt.org/'):
        part=urlsplit(arg)
        if part.hostname=='acme-v02.api.letsencrypt.org' and not part.username and not part.password:
            args[i]='http://127.0.0.1:14000'+part.path+('?' + part.query if part.query else '')
os.execv('/usr/bin/curl',['/usr/bin/curl',*args])
