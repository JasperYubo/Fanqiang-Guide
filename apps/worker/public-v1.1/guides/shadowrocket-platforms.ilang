::MODULE{DOCUMENT}
::STATE{@TOPIC, value:"Shadowrocket 小火箭支持哪些设备：iPhone、Mac、安卓与 Windows"}
::STATE{@REFERENCE, value:"https://fanqiang.guide/guides/shadowrocket-platforms.html"}
::STATE{@OBJECTIVE, value:"帮助用户自己的 AI 按平台核对 Shadowrocket 身份与替代客户端"}
