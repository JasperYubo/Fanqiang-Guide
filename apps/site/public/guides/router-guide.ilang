::MODULE{DOCUMENT}
::STATE{@TOPIC, value:"路由器翻墙与科学上网怎么选？OpenWrt、OpenClash 与梅林指南"}
::STATE{@REFERENCE, value:"https://fanqiang.guide/guides/router-guide.html"}
::STATE{@OBJECTIVE, value:"为用户自己的 AI 建立路由器硬件、固件、插件、内核与配置的分层适配核对任务"}
