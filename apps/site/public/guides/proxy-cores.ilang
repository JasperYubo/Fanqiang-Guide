::MODULE{DOCUMENT}
::STATE{@TOPIC, value:"Mihomo、sing-box 与 Xray：代理内核、客户端和 TUN 的关系"}
::STATE{@REFERENCE, value:"https://fanqiang.guide/guides/proxy-cores.html"}
::STATE{@OBJECTIVE, value:"为用户自己的 AI 建立客户端、内核与配置能力的对应检查"}
::STATE{@EXECUTION, value:{"actor":"visitors_own_AI","status":"not_executed","authority":"visitors_actual_request_and_existing_authorization","site_device_operations":false}}
